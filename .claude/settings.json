{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-hygiene.sh\" --yes"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/acs_guard.py\" ${DSH_SESSION_ID:+--harness dsh} session-start",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/issue-log/gh_issue_guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash|EnterWorktree|Agent|Task|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/acs_guard.py\" ${DSH_SESSION_ID:+--harness dsh} pre-tool",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/acs_guard.py\" ${DSH_SESSION_ID:+--harness dsh} stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
