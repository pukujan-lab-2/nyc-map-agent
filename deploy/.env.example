# Copy to /srv/nyc-map-agent/.env and chmod 600. Never commit this file.

# --- Deploy service ---------------------------------------------------------
CD_ADMIN_PASSWORD=
CD_SESSION_SECRET=
CD_DEPLOY_TOKEN=

# --- App image (build-time, public) ----------------------------------------
VITE_DATA_BACKEND=octo
MAPILLARY_TOKEN=

# --- App runtime secrets ----------------------------------------------------
OCTO_API_KEY=
OCTO_WORKSPACE_ID=
INFERHUB_API_KEY=
INFERHUB_BASE_URL=https://api.inferhub.dev/v1
MTA_BUSTIME_KEY=
SOCRATA_KEY_ID=
SOCRATA_KEY_SECRET=

# --- Deploy service, host plumbing (optional; defaults match gravebuster) ---
# CD_UID / CD_GID          owner of the checkout; the CD container runs as them
# CD_DOCKER_GID            gid of /var/run/docker.sock on the host
# CD_GIT_CREDENTIALS       host path to a git credential store for the private
#                          repo; mounted read-only at /tmp/.git-credentials

# Optional, server only. Event lookup on request (TinyFish search + fetch).
TINYFISH_API_KEY=
# Optional, server only. Speech-to-text for Brave/Firefox: an OpenAI-compatible Whisper server you run
# (STT_BASE_URL, for example http://127.0.0.1:8080/v1; STT_API_KEY only if it wants one). No hosted default:
# without STT_BASE_URL the app says voice is not set up. On the VPS it is the shared speech gateway:
# STT_BASE_URL=http://host.docker.internal:18800, STT_PROTOCOL=speech, STT_STACK=multilingual (Whisper large-v3-turbo).
# STT_PROJECT names the app to the gateway (X-Speech-Project); it defaults to nyc-map.
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=

# The hands-free live call (pilot, ?flags=+liveCall, issue 299). Off until the key and secret are set: /api/voice/token answers
# 503 and hands-free takes one question at a time. They are the LiveKit server's API key and secret (design-bakery's server,
# wss://copilot.design-bakery.com unless LIVEKIT_PUBLIC_URL says otherwise). The token asks for the voice-agent/ worker by name
# (LIVEKIT_AGENT_NAME, default nyc-map-voice); the presenter's calls ask for LIVEKIT_PRESENTER_AGENT_NAME (default design-bakery-voice).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=
