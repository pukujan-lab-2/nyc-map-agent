  {
    "name": "street view: mapillary (lazy)",
    "path": ".size-build/assets/mapillary*.js",
    "limit": "232 kB"
  },
  {
    "name": "aggregate worker",
    "path": ".size-build/assets/aggregate.worker-*.js",
