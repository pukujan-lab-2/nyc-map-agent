[
  {
    "name": "app entry (index chunks: the loader that waits for the first paint)",
    "path": ".size-build/assets/index-*.js",
    "limit": "12 kB"
  },
  {
    "name": "app (boot chunk, loaded after the first paint)",
    "path": ".size-build/assets/boot-*.js",
    "limit": "280.5 kB"
  },
  {
    "name": "map library (maplibre-gl, its own chunk so it stays cached across deploys)",
    "path": ".size-build/assets/maplibre-*.js",
    "limit": "255 kB"
  },
  {
    "name": "feature: restrooms (lazy)",
    "path": ".size-build/assets/restrooms-*.js",
